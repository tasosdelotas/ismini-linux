#!/bin/bash
# ismini postrm — runs after the package files are removed.
set -uo pipefail

case "${1:-}" in
  remove|deconfigure)
    # Remove desktop menu + icon entries we created.
    rm -f /usr/share/applications/ismini.desktop
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then
      DESKTOP_DIR="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
      [ -z "$DESKTOP_DIR" ] && DESKTOP_DIR="$HOME/Desktop"
      rm -f "$DESKTOP_DIR/ismini.desktop" 2>/dev/null || true
    fi

    # NOTE: we intentionally do NOT delete the user's data. ismini keeps its
    # config, sessions, and memory in ~/ismini alongside the app files.
    # Removing that would destroy chat history and memories — so it's left for
    # the user to remove manually if they want (uninstall.sh does this with a
    # backup).
    echo "ismini removed. Your data (config, sessions, memory) is kept in ~/ismini."
    ;;
esac

exit 0
