{
  "backend": "llama-cpp",
  "llamaCpp": {
    "port": 8080,
    "context": 8192,
    "reasoning": "off",
    "parallel": 1
  },
  "agent": {
    "timeoutSeconds": 3600,
    "contextWindow": 8192,
    "maxTokens": 8192
  },
  "tools": {
    "enabled": [
      "read",
      "write",
      "edit",
      "delete",
      "exec",
      "web_search",
      "web_fetch",
      "weather",
      "memory_add",
      "memory_search",
      "memory_delete",
      "recall",
      "skills"
    ],
    "sudo": true
  }
}
