#!/bin/bash
# ismini prerm — runs before the package files are removed.
set -uo pipefail

detect_user_home() {
  local target_user="${SUDO_USER:-}"
  if [ -z "$target_user" ] && [ "$(id -u)" != "0" ]; then
    target_user="$(whoami)"
  fi
  if [ -n "$target_user" ]; then
    getent passwd "$target_user" | cut -d: -f6
    return
  fi
  local uid home
  for entry in $(getent passwd | awk -F: '$3 >= 1000 {print $1}'); do
    uid=$(id "$entry" 2>/dev/null || echo 99999)
    if [ "$uid" -ge 1000 ] 2>/dev/null; then
      home=$(getent passwd "$entry" | cut -d: -f6)
      [ -n "$home" ] && { echo "$home"; return; }
    fi
  done
  echo "/root"
}

USER_HOME="$(detect_user_home)"
APP_DIR="${ISMINI_HOME:-$USER_HOME/ismini}"

# Stop any running ismini server, so we don't remove files out from under a
# live process. (Chat data and memory are kept — see postrm.)
for proc in /proc/[0-9]*; do
  [ -r "$proc/cmdline" ] || continue
  if tr '\0' ' ' < "$proc/cmdline" 2>/dev/null | grep -q "$APP_DIR/web.js"; then
    pid="${proc##*/}"
    kill "$pid" >/dev/null 2>&1 || true
  fi
done

# Give it a moment to exit gracefully.
for _ in $(seq 1 10); do
  alive=0
  for proc in /proc/[0-9]*; do
    [ -r "$proc/cmdline" ] || continue
    if tr '\0' ' ' < "$proc/cmdline" 2>/dev/null | grep -q "$APP_DIR/web.js"; then
      alive=1; break
    fi
  done
  [ "$alive" -eq 0 ] && break
  sleep 0.25
done

exit 0
