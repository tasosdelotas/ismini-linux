#!/bin/bash
# ismini — Web UI launcher: starts the server if not running, then opens the browser.
#
# GUI-aware: when a desktop session is present (DISPLAY set), failures show a
# native dialog (zenity/kdialog) instead of dying silently in a terminal nobody
# watches. Without a display it falls back to stderr messages.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

gui_msg() { # gui_msg <title> <message>
  local title="$1" msg="$2"
  if [ -n "$DISPLAY" ]; then
    if command -v zenity >/dev/null 2>&1; then
      zenity --error --title="$title" --text="$msg" 2>/dev/null && return
    fi
    if command -v kdialog >/dev/null 2>&1; then
      kdialog --error "$msg" --title "$title" 2>/dev/null && return
    fi
  fi
  echo "ERROR: $msg" >&2
}

# ── Prerequisites ────────────────────────────────────────────────────────────
if ! command -v node >/dev/null 2>&1; then
  gui_msg "ismini" "Node.js was not found. Install it from https://nodejs.org and try again."
  exit 1
fi

# Port: honor an explicit --port argument, else the default. web.js reads the
# same value (it also accepts WEB_PORT), so launcher and server always agree.
PORT="${2:-8787}"
URL="http://127.0.0.1:${PORT}/"

server_ready() {
  node --input-type=module -e '
    try {
      const response = await fetch(process.argv[1], { signal: AbortSignal.timeout(1000) });
      process.exit(response.ok ? 0 : 1);
    } catch {
      process.exit(1);
    }
  ' "$URL" >/dev/null 2>&1
}

# Already running? Just open the browser.
if server_ready; then
  if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$URL"
  fi
  gui_msg "ismini" "xdg-open was not found, so ismini cannot open your browser automatically.\n\nOpen this address manually:\n$URL"
  exit 1
fi

# Start detached. Log to a per-user file (not world-readable /tmp) and record
# the PID so we can report what happened if startup fails.
LOG="$DIR/ismini.log"
PIDFILE="$DIR/ismini.pid"
nohup node "$DIR/web.js" --port "$PORT" > "$LOG" 2>&1 &
echo $! > "$PIDFILE"

for _ in $(seq 1 20); do
  sleep 0.5
  server_ready && break
done

if ! server_ready; then
  # The process is gone — show the tail of its log so the user sees WHY.
  detail=""
  if [ -f "$LOG" ]; then
    detail=$(tail -n 5 "$LOG" | tr '\n' ' ')
  fi
  rm -f "$PIDFILE"
  gui_msg "ismini" "ismini did not start.\n\n${detail:-No log output.}\n\nFull log: $LOG"
  exit 1
fi

if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$URL"
fi
gui_msg "ismini" "xdg-open was not found, so ismini cannot open your browser automatically.\n\nOpen this address manually:\n$URL"
exit 1
