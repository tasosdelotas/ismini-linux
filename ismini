#!/bin/bash
# ismini launcher: starts Node + Web UI

cd "$(dirname "$0")"

# Use bundled Node if available, otherwise fallback to system Node
if [ -f "./node-v22.23.2-linux-x64/bin/node" ]; then
    NODE_BIN="./node-v22.23.2-linux-x64/bin/node"
else
    # Fallback to system node or check common locations
    if command -v node >/dev/null 2>&1; then
        NODE_BIN="node"
    else
        echo "Error: Node.js not found. Please install Node.js v22+ or place bundled version in ismini folder."
        exit 1
    fi
fi

# Start the web server on port 8787 (or custom from env)
exec "$NODE_BIN" ./web.js ${@}